datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EMPLOYEE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relations
  sessions     Session[]
  authLogs     AuthLog[]
  employee     Employee?
  notifications Notification[] @relation("UserNotifications")
  preferences  NotificationPreference? @relation("UserPreferences")
  activities   ActivityLog[]  @relation("UserActivities")
  assetHistoryLogs AssetHistory[] @relation("UserAssetHistory")
  
  // Phase 18 Relations
  authoredArticles   KnowledgeArticle[]  @relation("AuthoredArticles")
  kbVersions         KnowledgeVersion[]  @relation("KbVersionAuthor")
  knowledgeFavorites KnowledgeFavorite[] @relation("UserFavorites")
  aiConversations    AiConversation[]    @relation("UserConversations")
  automationRules    AutomationRule[]    @relation("RuleCreator")

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  userId       String
  userAgent    String
  ipAddress    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuthLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  status    String
  ipAddress String
  userAgent String
  timestamp DateTime @default(now())

  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("auth_logs")
}

model Employee {
  id                 String         @id @default(uuid())
  employeeCode       String         @unique
  userId             String?        @unique
  firstName          String
  lastName           String
  email              String         @unique
  phone              String
  designation        String
  departmentId       String?        
  managerId          String?        // Nullable
  hireDate           DateTime
  avatar             String?
  status             EmployeeStatus @default(ACTIVE)
  isDeleted          Boolean        @default(false)
  deletedAt          DateTime?
  
  // Audit properties
  createdById        String?
  updatedById        String?
  deletedById        String?
  
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department?    @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[]   @relation("DepartmentManager")
  managedProjects    Project[]      @relation("ProjectManager")
  projectMemberships ProjectMember[]
  reportedTasks      Task[]         @relation("ReporterTasks")
  taskAssignments    TaskAssignee[]
  taskComments       TaskComment[]
  uploadedAttachments TaskAttachment[] @relation("UploaderAttachments")
  leaves             Leave[]          @relation("EmployeeLeaves")
  approvedLeaves     Leave[]          @relation("ApprovedLeaves")
  calendarEvents     CalendarEvent[]  @relation("EmployeeEvents")
  recurringEvents    RecurringEvent[]
  attendances        Attendance[]     @relation("EmployeeAttendances")
  attendanceRequests AttendanceRequest[] @relation("EmployeeAttendanceRequests")
  approvedAttendanceRequests AttendanceRequest[] @relation("ApprovedAttendanceRequests")
  timesheets         Timesheet[]      @relation("EmployeeTimesheets")
  uploadedDocuments  Document[]       @relation("DocumentUploader")
  uploadedDocumentVersions DocumentVersion[] @relation("VersionUploader")
  salaryStructure    SalaryStructure?  @relation("EmployeeSalaryStructure")
  payrollItems       PayrollItem[]     @relation("EmployeePayrollItems")
  managerJobs        JobOpening[]      @relation("ManagerJobs")
  panelInterviews    InterviewPanelMember[] @relation("PanelMemberEmployee")
  interviewerFeedbacks InterviewFeedback[]  @relation("InterviewerFeedback")
  stageHistoryChanges CandidateStageHistory[] @relation("StageHistoryChanger")
  assignedAssets     Asset[]           @relation("EmployeeAssets")
  assetAssignments   AssetAssignment[] @relation("EmployeeAssetAssignments")
  createdAssignments AssetAssignment[] @relation("AssignedByEmployee")
  transferredFrom    AssetTransfer[]   @relation("TransferredFromEmployee")
  transferredTo      AssetTransfer[]   @relation("TransferredToEmployee")
  createdTransfers   AssetTransfer[]   @relation("TransferredByEmployee")

  @@index([employeeCode])
  @@index([email])
  @@index([status])
  @@index([managerId])
  @@map("employees")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id           String           @id @default(uuid())
  name         String           @unique
  code         String           @unique
  description  String?
  managerId    String?          // Links to Employee.id (Nullable)
  location     String
  email        String
  phone        String
  status       DepartmentStatus @default(ACTIVE)
  isDeleted    Boolean          @default(false)
  deletedAt    DateTime?

  // Audit Fields
  createdById  String?
  updatedById  String?
  deletedById  String?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  employees    Employee[]       @relation("DepartmentEmployees")
  manager      Employee?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  projects     Project[]        @relation("DepartmentProjects")
  jobs         JobOpening[]     @relation("DepartmentJobs")
  assets       Asset[]          @relation("DepartmentAssets")

  @@index([code])
  @@index([status])
  @@index([managerId])
  @@index([createdAt])
  @@map("departments")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  TEAM_LEAD
  DEVELOPER
  TESTER
  DESIGNER
  BUSINESS_ANALYST
  MEMBER
}

model Project {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  description  String?
  departmentId String
  managerId    String?         // Links to Employee.id (Nullable)
  startDate    DateTime
  endDate      DateTime
  priority     ProjectPriority @default(MEDIUM)
  status       ProjectStatus   @default(PLANNING)
  budget       Float?
  progress     Int             @default(0)
  isDeleted    Boolean         @default(false)
  deletedAt    DateTime?

  // Audit Fields
  createdById  String?
  updatedById  String?
  deletedById  String?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  department   Department      @relation("DepartmentProjects", fields: [departmentId], references: [id], onDelete: Restrict)
  manager      Employee?       @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  tasks        Task[]          @relation("ProjectTasks")
  calendarEvents CalendarEvent[] @relation("ProjectEvents")

  @@index([code])
  @@index([status])
  @@index([priority])
  @@index([departmentId])
  @@index([managerId])
  @@map("projects")
}

model ProjectMember {
  id         String            @id @default(uuid())
  projectId  String
  employeeId String
  role       ProjectMemberRole @default(MEMBER)
  joinedAt   DateTime          @default(now())

  // Relations
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
  @@map("project_members")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  FEATURE
  BUG
  IMPROVEMENT
  DOCUMENTATION
  RESEARCH
}

model Task {
  id                   String           @id @default(uuid())
  taskCode             String           @unique
  title                String
  description          String?
  projectId            String
  parentTaskId         String?
  reporterId           String?          
  status               TaskStatus       @default(TODO)
  priority             TaskPriority     @default(MEDIUM)
  type                 TaskType         @default(FEATURE)
  dueDate              DateTime?
  estimatedHours       Float?
  actualHours          Float?
  completionPercentage Int              @default(0)
  isDeleted            Boolean          @default(false)
  deletedAt            DateTime?

  // Audit Fields
  createdById          String?
  updatedById          String?
  deletedById          String?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relations
  project              Project          @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: Cascade)
  parentTask           Task?            @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subTasks             Task[]           @relation("SubTasks")
  reporter             Employee?        @relation("ReporterTasks", fields: [reporterId], references: [id], onDelete: SetNull)
  assignees            TaskAssignee[]
  comments             TaskComment[]
  attachments          TaskAttachment[]
  dependencies         TaskDependency[] @relation("TaskDependent")
  blockedTasks         TaskDependency[] @relation("TaskBlocked")
  labels               TaskLabel[]      @relation("TaskLabels")
  calendarEvents       CalendarEvent[]  @relation("TaskEvents")

  @@index([taskCode])
  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([parentTaskId])
  @@index([reporterId])
  @@map("tasks")
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  employeeId String
  assignedAt DateTime @default(now())

  // Relations
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@index([taskId])
  @@index([employeeId])
  @@map("task_assignees")
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  // Relations
  task            Task     @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskBlocked", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskComment {
  id         String    @id @default(uuid())
  taskId     String
  employeeId String
  comment    String
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([employeeId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  fileName     String
  filePath     String
  fileType     String
  uploadedById String
  createdAt    DateTime @default(now())

  // Relations
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader     Employee @relation("UploaderAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachments")
}

model TaskLabel {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks     Task[]   @relation("TaskLabels")

  @@map("task_labels")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMPLETED
  PROJECT_CREATED
  PROJECT_UPDATED
  EMPLOYEE_CREATED
  DEPARTMENT_CREATED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ASSIGN
  UNASSIGN
  LOGIN
  LOGOUT
  STATUS_CHANGE
  COMMENT
  UPLOAD
  DOWNLOAD
  EXPORT
}

model Notification {
  id         String               @id @default(uuid())
  userId     String
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority @default(MEDIUM)
  entityType String
  entityId   String
  actionUrl  String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  // Relations
  user       User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String  @id @default(uuid())
  userId          String  @unique
  email           Boolean @default(true)
  inApp           Boolean @default(true)
  taskAssigned    Boolean @default(true)
  taskUpdated     Boolean @default(true)
  taskCompleted   Boolean @default(true)
  projectCreated  Boolean @default(true)
  projectUpdated  Boolean @default(true)
  commentAdded    Boolean @default(true)
  attachmentAdded Boolean @default(true)

  // Relations
  user            User    @relation("UserPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ActivityLog {
  id          String         @id @default(uuid())
  userId      String?
  action      ActivityAction
  entityType  String
  entityId    String
  description String
  metadata    Json
  ipAddress   String
  userAgent   String
  createdAt   DateTime       @default(now())

  // Relations
  user        User?          @relation("UserActivities", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  PAID
  UNPAID
  MATERNITY
  PATERNITY
}

enum CalendarEventType {
  TASK
  PROJECT
  MEETING
  HOLIDAY
  LEAVE
  CUSTOM
}

model Leave {
  id              String      @id @default(uuid())
  employeeId      String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  employee        Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy      Employee?   @relation("ApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)
  calendarEvents  CalendarEvent[] @relation("LeaveEvents")

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("leaves")
}

model CalendarEvent {
  id               String            @id @default(uuid())
  title            String
  description      String?
  type             CalendarEventType
  startDate        DateTime
  endDate          DateTime
  isAllDay         Boolean           @default(false)
  employeeId       String?
  projectId        String?
  taskId           String?
  leaveId          String?
  holidayId        String?
  recurringEventId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  employee         Employee?         @relation("EmployeeEvents", fields: [employeeId], references: [id], onDelete: Cascade)
  project          Project?          @relation("ProjectEvents", fields: [projectId], references: [id], onDelete: Cascade)
  task             Task?             @relation("TaskEvents", fields: [taskId], references: [id], onDelete: Cascade)
  leave            Leave?            @relation("LeaveEvents", fields: [leaveId], references: [id], onDelete: Cascade)
  holiday          Holiday?          @relation("HolidayEvents", fields: [holidayId], references: [id], onDelete: Cascade)
  recurringEvent   RecurringEvent?   @relation("RecurringEventOccurrences", fields: [recurringEventId], references: [id], onDelete: Cascade)
  interview        Interview?        @relation("InterviewCalendarEvent")

  @@index([employeeId])
  @@index([projectId])
  @@index([taskId])
  @@index([leaveId])
  @@index([holidayId])
  @@index([recurringEventId])
  @@index([startDate])
  @@index([endDate])
  @@index([type])
  @@map("calendar_events")
}

model Holiday {
  id             String          @id @default(uuid())
  name           String
  date           DateTime
  isGlobal       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  calendarEvents CalendarEvent[] @relation("HolidayEvents")

  @@index([date])
  @@map("holidays")
}

model RecurringEvent {
  id                String            @id @default(uuid())
  title             String
  description       String?
  type              CalendarEventType
  startDate         DateTime
  endDate           DateTime
  recurrenceRule    String            // 'DAILY', 'WEEKLY', 'MONTHLY', 'YEARLY'
  recurrenceEndDate DateTime?
  employeeId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  occurrences       CalendarEvent[]   @relation("RecurringEventOccurrences")

  @@index([employeeId])
  @@map("recurring_events")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum WorkSessionStatus {
  ACTIVE
  COMPLETED
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Attendance {
  id             String           @id @default(uuid())
  employeeId     String
  date           DateTime         // Date representation (midnight UTC)
  status         AttendanceStatus @default(PRESENT)
  clockIn        DateTime?
  clockOut       DateTime?
  totalHours     Float            @default(0)
  overtimeHours  Float            @default(0)
  breakDuration  Int              @default(0) // duration in minutes
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  employee       Employee         @relation("EmployeeAttendances", fields: [employeeId], references: [id], onDelete: Cascade)
  workSessions   WorkSession[]    @relation("AttendanceSessions")

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

model WorkSession {
  id           String            @id @default(uuid())
  attendanceId String
  type         String            @default("WORKING") // "WORKING", "BREAK"
  status       WorkSessionStatus @default(ACTIVE)
  startTime    DateTime
  endTime      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  attendance   Attendance        @relation("AttendanceSessions", fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("work_sessions")
}

model AttendanceRequest {
  id                String                  @id @default(uuid())
  employeeId        String
  date              DateTime
  requestedStatus   AttendanceStatus?
  originalClockIn   DateTime?
  originalClockOut  DateTime?
  requestedClockIn  DateTime?
  requestedClockOut  DateTime?
  reason            String
  status            AttendanceRequestStatus @default(PENDING)
  approvedById      String?
  rejectionReason   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  // Relations
  employee          Employee                @relation("EmployeeAttendanceRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy        Employee?               @relation("ApprovedAttendanceRequests", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@map("attendance_requests")
}

model Timesheet {
  id                   String      @id @default(uuid())
  employeeId           String
  startDate            DateTime
  endDate              DateTime
  totalRegularHours    Float       @default(0)
  totalOvertimeHours   Float       @default(0)
  attendancePercentage Float       @default(0)
  status               String      @default("APPROVED")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relations
  employee             Employee    @relation("EmployeeTimesheets", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("timesheets")
}

enum DocumentEntityType {
  EMPLOYEE
  PROJECT
  TASK
  DEPARTMENT
  LEAVE
  ATTENDANCE
  GENERAL
  RECRUITMENT
  ASSET
  MAINTENANCE
}

enum DocumentCategory {
  PROFILE
  CONTRACT
  REPORT
  IMAGE
  PDF
  SPREADSHEET
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Document {
  id           String             @id @default(uuid())
  name         String
  entityType   DocumentEntityType
  entityId     String?
  category     DocumentCategory
  status       DocumentStatus     @default(ACTIVE)
  uploadedById String
  isDeleted    Boolean            @default(false)
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  uploadedBy   Employee           @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]  @relation("DocumentVersions")
  candidateDocuments CandidateDocument[] @relation("RecruitmentDocuments")
  offerLetters       OfferLetter[]       @relation("OfferLetterDocument")

  @@index([entityType])
  @@index([entityId])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String
  versionNumber    Int
  originalFilename String
  storedFilename   String
  extension        String
  mimeType         String
  fileSize         Int
  checksum         String?
  filePath         String
  uploadedById     String
  createdAt        DateTime @default(now())

  // Relations
  document         Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       Employee @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("document_versions")
}

enum PayrollStatus {
  DRAFT
  GENERATED
  APPROVED
  PAID
  CANCELLED
}

enum SalaryComponentType {
  BASIC
  ALLOWANCE
  BONUS
  DEDUCTION
  TAX
  OVERTIME
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

model SalaryStructure {
  id           String            @id @default(uuid())
  employeeId   String            @unique
  baseSalary   Float
  currency     String            @default("USD")
  effectiveFrom DateTime
  effectiveTo  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  employee     Employee          @relation("EmployeeSalaryStructure", fields: [employeeId], references: [id], onDelete: Cascade)
  components   SalaryComponent[]

  @@map("salary_structures")
}

model SalaryComponent {
  id                String              @id @default(uuid())
  salaryStructureId String
  name              String
  type              SalaryComponentType
  amount            Float
  isPercentage      Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  salaryStructure   SalaryStructure     @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@map("salary_components")
}

model Payroll {
  id          String        @id @default(uuid())
  month       Int
  year        Int
  status      PayrollStatus @default(DRAFT)
  processedBy String?
  approvedBy  String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  items       PayrollItem[]

  @@unique([month, year])
  @@map("payrolls")
}

model PayrollItem {
  id             String         @id @default(uuid())
  payrollId      String
  employeeId     String
  basicSalary    Float
  allowances     Float          @default(0)
  bonuses        Float          @default(0)
  deductions     Float          @default(0)
  overtimePay    Float          @default(0)
  tax            Float          @default(0)
  grossSalary    Float
  netSalary      Float
  paymentMethod  PaymentMethod  @default(BANK_TRANSFER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  payroll        Payroll        @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee       Employee       @relation("EmployeePayrollItems", fields: [employeeId], references: [id], onDelete: Cascade)
  payslips       Payslip[]

  @@unique([payrollId, employeeId])
  @@map("payroll_items")
}

model Payslip {
  id            String      @id @default(uuid())
  payrollItemId String      @unique
  payslipNumber String      @unique
  pdfPath       String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@map("payslips")
}

model TaxRule {
  id          String   @id @default(uuid())
  name        String
  minIncome   Float
  maxIncome   Float?
  taxRate     Float
  flatAmount  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tax_rules")
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum CandidateStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum InterviewResult {
  PASS
  FAIL
  HOLD
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model JobOpening {
  id              String        @id @default(uuid())
  title           String
  description     String
  requirements    String?
  departmentId    String
  hiringManagerId String
  status          JobStatus     @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  department      Department    @relation("DepartmentJobs", fields: [departmentId], references: [id], onDelete: Cascade)
  hiringManager   Employee      @relation("ManagerJobs", fields: [hiringManagerId], references: [id], onDelete: Cascade)
  candidates      Candidate[]
  offers          OfferLetter[]

  @@map("job_openings")
}

model Candidate {
  id              String                  @id @default(uuid())
  jobOpeningId    String
  firstName       String
  lastName        String
  email           String
  phone           String
  status          CandidateStatus         @default(APPLIED)
  resumeUrl       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Relations
  job             JobOpening              @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  documents       CandidateDocument[]
  interviews      Interview[]
  feedbacks       InterviewFeedback[]
  offers          OfferLetter[]
  stageHistory    CandidateStageHistory[]

  @@unique([email, phone])
  @@map("candidates")
}

model CandidateDocument {
  id          String    @id @default(uuid())
  candidateId String
  documentId  String    @unique
  type        String
  createdAt   DateTime  @default(now())

  // Relations
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  document    Document  @relation("RecruitmentDocuments", fields: [documentId], references: [id], onDelete: Cascade)

  @@map("candidate_documents")
}

model Interview {
  id              String                 @id @default(uuid())
  candidateId     String
  title           String
  type            String
  scheduledAt     DateTime
  durationMinutes Int                    @default(60)
  status          InterviewStatus        @default(SCHEDULED)
  calendarEventId String?                @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relations
  candidate       Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  panelMembers    InterviewPanelMember[]
  calendarEvent   CalendarEvent?         @relation("InterviewCalendarEvent", fields: [calendarEventId], references: [id], onDelete: SetNull)
  feedbacks       InterviewFeedback[]

  @@map("interviews")
}

model InterviewPanelMember {
  id          String    @id @default(uuid())
  interviewId String
  employeeId  String
  createdAt   DateTime  @default(now())

  // Relations
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employee    Employee  @relation("PanelMemberEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([interviewId, employeeId])
  @@map("interview_panel_members")
}

model InterviewFeedback {
  id              String          @id @default(uuid())
  interviewId     String
  interviewerId   String
  candidateId     String
  score           Int
  comments        String
  result          InterviewResult @default(HOLD)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  interview       Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer     Employee        @relation("InterviewerFeedback", fields: [interviewerId], references: [id], onDelete: Cascade)
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("interview_feedbacks")
}

model OfferLetter {
  id           String      @id @default(uuid())
  candidateId  String
  jobOpeningId String
  grossSalary  Float
  status       OfferStatus @default(DRAFT)
  sentAt       DateTime?
  expiresAt    DateTime?
  documentId   String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  candidate    Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening   JobOpening  @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  document     Document?   @relation("OfferLetterDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@map("offer_letters")
}

model RecruitmentStage {
  id        String   @id @default(uuid())
  name      String   @unique
  sequence  Int      @unique
  createdAt DateTime @default(now())

  @@map("recruitment_stages")
}

model CandidateStageHistory {
  id          String   @id @default(uuid())
  candidateId String
  stage       String
  changedById String
  createdAt   DateTime @default(now())

  // Relations
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  changedBy   Employee  @relation("StageHistoryChanger", fields: [changedById], references: [id], onDelete: Cascade)

  @@map("candidate_stage_history")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  LOST
  DAMAGED
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model AssetCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@map("asset_categories")
}

model Vendor {
  id             String          @id @default(uuid())
  name           String          @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assets         Asset[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model Asset {
  id                  String               @id @default(uuid())
  tag                 String               @unique
  name                String
  serialNumber        String?
  categoryId          String
  vendorId            String?
  status              AssetStatus          @default(AVAILABLE)
  condition           AssetCondition       @default(NEW)
  purchasePrice       Float
  salvageValue        Float                @default(0)
  usefulLifeYears     Int                  @default(5)
  purchaseDate        DateTime
  warrantyExpiry      DateTime?
  description         String?
  location            String?
  qrCodeUrl           String?
  barcodeUrl          String?
  departmentId        String?
  currentEmployeeId   String?
  purchaseOrderId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relations
  category            AssetCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendor              Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  department          Department?          @relation("DepartmentAssets", fields: [departmentId], references: [id], onDelete: SetNull)
  currentEmployee     Employee?            @relation("EmployeeAssets", fields: [currentEmployeeId], references: [id], onDelete: SetNull)
  purchaseOrder       PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  assignments         AssetAssignment[]
  transfers           AssetTransfer[]
  maintenanceRecords  MaintenanceRecord[]
  history             AssetHistory[]
  depreciationRecords DepreciationRecord[]

  @@map("assets")
}

model AssetAssignment {
  id                String         @id @default(uuid())
  assetId           String
  employeeId        String
  assignedAt        DateTime       @default(now())
  returnedAt        DateTime?
  conditionOnAssign AssetCondition
  conditionOnReturn AssetCondition?
  notes             String?
  assignedById      String

  // Relations
  asset             Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee          Employee       @relation("EmployeeAssetAssignments", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy        Employee       @relation("AssignedByEmployee", fields: [assignedById], references: [id], onDelete: Cascade)

  @@map("asset_assignments")
}

model AssetTransfer {
  id              String   @id @default(uuid())
  assetId         String
  fromEmployeeId  String?
  toEmployeeId    String
  transferredAt   DateTime @default(now())
  notes           String?
  transferredById String

  // Relations
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromEmployee    Employee? @relation("TransferredFromEmployee", fields: [fromEmployeeId], references: [id], onDelete: SetNull)
  toEmployee      Employee  @relation("TransferredToEmployee", fields: [toEmployeeId], references: [id], onDelete: Cascade)
  transferredBy   Employee  @relation("TransferredByEmployee", fields: [transferredById], references: [id], onDelete: Cascade)

  @@map("asset_transfers")
}

model MaintenanceRecord {
  id            String            @id @default(uuid())
  assetId       String
  title         String
  description   String?
  cost          Float             @default(0)
  scheduledDate DateTime
  startDate     DateTime?
  endDate       DateTime?
  status        MaintenanceStatus @default(SCHEDULED)
  performedBy   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  asset         Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("maintenance_records")
}

model AssetHistory {
  id          String   @id @default(uuid())
  assetId     String
  action      String
  description String
  userId      String?
  createdAt   DateTime @default(now())

  // Relations
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user        User?    @relation("UserAssetHistory", fields: [userId], references: [id], onDelete: SetNull)

  @@map("asset_history")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  vendorId    String
  orderDate   DateTime
  totalAmount Float
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assets      Asset[]

  @@map("purchase_orders")
}

model DepreciationRecord {
  id               String             @id @default(uuid())
  assetId          String
  depreciationDate DateTime
  depreciatedValue Float
  bookValue        Float
  method           DepreciationMethod
  createdAt        DateTime           @default(now())

  // Relations
  asset            Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("depreciation_records")
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AutomationStatus {
  ACTIVE
  INACTIVE
  FAILED
}

enum AutomationTrigger {
  TASK_COMPLETED
  EMPLOYEE_JOINED
  PAYROLL_APPROVED
  LEAVE_APPROVED
  CANDIDATE_HIRED
}

enum AutomationAction {
  NOTIFY_MANAGER
  GENERATE_DOCUMENTS
  NOTIFY_EMPLOYEE
  UPDATE_CALENDAR
  CREATE_EMPLOYEE
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model KnowledgeCategory {
  id          String             @id @default(uuid())
  name        String             @unique
  slug        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  articles    KnowledgeArticle[]

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id          String             @id @default(uuid())
  title       String
  slug        String             @unique
  content     String
  status      KnowledgeStatus    @default(DRAFT)
  authorId    String
  categoryId  String
  viewCount   Int                @default(0)
  isDeleted   Boolean            @default(false)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  category    KnowledgeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author      User               @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: Cascade)
  versions    KnowledgeVersion[]
  favorites   KnowledgeFavorite[]

  @@map("knowledge_articles")
}

model KnowledgeVersion {
  id            String           @id @default(uuid())
  articleId     String
  versionNumber Int
  title         String
  content       String
  authorId      String
  createdAt     DateTime         @default(now())

  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author        User             @relation("KbVersionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("knowledge_versions")
}

model KnowledgeFavorite {
  id        String           @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime         @default(now())

  user      User             @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("knowledge_favorites")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  user      User        @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           ChatRole
  content        String
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model AutomationRule {
  id          String               @id @default(uuid())
  title       String
  trigger     AutomationTrigger
  conditions  String?              // JSON string of conditions
  action      AutomationAction
  actionConfig String?             // JSON string configuration
  status      AutomationStatus     @default(ACTIVE)
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  executions  AutomationExecution[]

  createdBy   User                 @relation("RuleCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model AutomationExecution {
  id             String            @id @default(uuid())
  ruleId         String
  triggerPayload String?           // JSON string of triggering data
  actionResult   String?           // JSON details of action execution
  status         String            // "SUCCESS" | "FAILED"
  errorMessage   String?
  executedAt     DateTime          @default(now())

  rule           AutomationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("automation_executions")
}

model AiSuggestion {
  id         String   @id @default(uuid())
  entityType String   // "TASK" | "PROJECT" | "EMPLOYEE"
  entityId   String
  type       String   // "PRIORITY" | "RISK" | "WORKLOAD"
  content    String
  isApplied  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("ai_suggestions")
}

enum FeatureFlagStatus {
  ENABLED
  DISABLED
}

enum BackupStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
}

enum JobExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum MaintenanceModeStatus {
  ENABLED
  DISABLED
}

model OrganizationSetting {
  id                String    @id @default(uuid())
  companyName       String
  logo              String?
  address           String?
  timeZone          String    @default("UTC")
  currency          String    @default("USD")
  language          String    @default("en")
  dateFormat        String    @default("YYYY-MM-DD")
  fiscalYearStart   DateTime?
  workingDays       String    @default("MON,TUE,WED,THU,FRI")
  workingHoursStart String    @default("09:00")
  workingHoursEnd   String    @default("17:00")
  publicHolidays    String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("organization_settings")
}

model FeatureFlag {
  id          String            @id @default(uuid())
  key         String            @unique
  description String?
  status      FeatureFlagStatus @default(ENABLED)
  roles       Role[]            @default([])
  environment String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("feature_flags")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  subject     String
  body        String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

model EmailHistory {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String   @db.Text
  status    String
  error     String?
  sentAt    DateTime @default(now())

  @@map("email_history")
}

model SystemBackup {
  id          String       @id @default(uuid())
  filename    String
  filePath    String
  backupType  String
  scope       String
  status      BackupStatus @default(IN_PROGRESS)
  sizeBytes   BigInt?
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("system_backups")
}

model ScheduledJob {
  id            String         @id @default(uuid())
  name          String         @unique
  cronExpr      String
  status        String
  lastRun       DateTime?
  nextRun       DateTime?
  executions    JobExecution[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("scheduled_jobs")
}

model JobExecution {
  id          String             @id @default(uuid())
  jobId       String
  job         ScheduledJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      JobExecutionStatus @default(PENDING)
  durationMs  Int?
  logs        String?            @db.Text
  error       String?            @db.Text
  executedAt  DateTime           @default(now())

  @@map("job_executions")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  module    String
  message   String   @db.Text
  userId    String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model ErrorLog {
  id               String   @id @default(uuid())
  message          String   @db.Text
  stack            String?  @db.Text
  module           String
  userId           String?
  resolutionStatus String   @default("UNRESOLVED")
  createdAt        DateTime @default(now())

  @@map("error_logs")
}

model ApiKey {
  id          String   @id @default(uuid())
  name        String
  keyHash     String   @unique
  valueEnc    String   @db.Text
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("api_keys")
}

model StorageConfiguration {
  id        String   @id @default(uuid())
  provider  String
  config    String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("storage_configurations")
}

model SmtpConfiguration {
  id        String   @id @default(uuid())
  host      String
  port      Int
  username  String
  password  String   @db.Text
  secure    Boolean  @default(true)
  fromEmail String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("smtp_configurations")
}

model SystemHealthSnapshot {
  id            String   @id @default(uuid())
  dbStatus      String   @default("UP")
  redisStatus   String   @default("UP")
  socketStatus  String   @default("UP")
  storageStatus String   @default("UP")
  smtpStatus    String   @default("UP")
  cpuUsage      Float
  memoryUsage   Float
  diskUsage     Float
  responseTime  Int
  uptime        Int
  createdAt     DateTime @default(now())

  @@map("system_health_snapshots")
}

model MaintenanceConfiguration {
  id         String                @id @default(uuid())
  status     MaintenanceModeStatus @default(DISABLED)
  message    String                @default("System is undergoing scheduled maintenance.")
  allowAdmin Boolean               @default(true)
  eta        DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@map("maintenance_configurations")
}







