# Port Number
PORT=5000

# Node Environment
NODE_ENV=production

# Database Connection URI (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/taskportal_db?schema=public"

# JSON Web Token Secret
JWT_SECRET="superproductionjwtsecretkey992211"

# Symmetric Encryption Key (32-byte hex for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis Server URL
REDIS_URL="redis://localhost:6379"

# Client URL (CORS origins bounds)
CLIENT_URL="http://localhost:80"

# SMTP Mail Server configurations
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@mg.yourdomain.com"
SMTP_PASS="your_encrypted_smtp_password"
SMTP_FROM="noreply@mg.yourdomain.com"

# Google AI Gemini API Token
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Decoupled Upload Drivers (LOCAL / S3 / AZURE)
STORAGE_PROVIDER="LOCAL"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
